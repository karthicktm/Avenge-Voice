# Railway Environment Variables Template
# Copy these to your Railway service environment variables

# ============================================
# BACKEND SERVICE ENVIRONMENT VARIABLES
# ============================================

# Database (PostgreSQL with pgvector)
# IMPORTANT: Use private endpoint for better security and performance
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}

# Alternative: Default URL (also uses private endpoint)
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway provides these automatically (you don't need to set them):
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, PGHOST, PGPORT
# DATABASE_PUBLIC_URL (only use for external access)

# Redis
# IMPORTANT: Use private endpoint for better security and performance
REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}

# Alternative: Default URL (also uses private endpoint)
# REDIS_URL=${{Redis.REDIS_URL}}

# Railway provides these automatically (you don't need to set them):
# REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
# REDIS_PUBLIC_URL (only use for external access)

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# Security
SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Set to your frontend Railway domain
CORS_ORIGINS=["https://your-frontend.up.railway.app","https://yourdomain.com"]

# OpenAI API (Required for RAG embeddings and GPT-4o Realtime)
OPENAI_API_KEY=sk-...

# Voice Providers (Choose based on pricing tier)
# Deepgram (STT for budget/balanced tiers)
DEEPGRAM_API_KEY=...

# ElevenLabs (TTS for premium tier)
ELEVENLABS_API_KEY=...

# Telephony Provider (Required for phone calls)
# Telnyx (Primary)
TELNYX_API_KEY=...
TELNYX_PUBLIC_KEY=...
# OR Twilio (Alternative)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...

# Optional: Integrations
# Google Calendar
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# SendGrid (Email/SMS)
SENDGRID_API_KEY=...

# ============================================
# FRONTEND SERVICE ENVIRONMENT VARIABLES
# ============================================

# Backend API URL - Set to your backend Railway service URL
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Build-time variables
NODE_ENV=production

# ============================================
# POSTGRESQL SERVICE (Railway Add-on)
# ============================================
# Railway automatically provides:
# - DATABASE_URL
# - PGHOST
# - PGPORT
# - PGUSER
# - PGPASSWORD
# - PGDATABASE

# NOTE: After adding PostgreSQL service, you need to:
# 1. Enable pgvector extension manually via Railway console:
#    Run SQL: CREATE EXTENSION IF NOT EXISTS vector;
# 2. Or run migrations which will enable it automatically

# ============================================
# REDIS SERVICE (Railway Add-on)
# ============================================
# Railway automatically provides:
# - REDIS_URL
# - REDIS_HOST
# - REDIS_PORT

# ============================================
# NOTES
# ============================================
# 1. Generate secure secrets:
#    openssl rand -hex 32
#
# 2. Railway services communicate via internal DNS:
#    - postgres.railway.internal
#    - redis.railway.internal
#    - backend.railway.internal
#
# 3. Public URLs are auto-generated:
#    - https://<service-name>.up.railway.app
#
# 4. Reference variables from other services:
#    ${{Postgres.DATABASE_URL}}
#    ${{Redis.REDIS_URL}}
