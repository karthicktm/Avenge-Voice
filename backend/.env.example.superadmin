# =============================================================================
# Super Admin Configuration
# =============================================================================
# Set these environment variables to automatically create a super admin on startup
# If not set, use the CLI command: python -m app.cli create-superuser

# SUPER_ADMIN_EMAIL=admin@mycompany.com
# SUPER_ADMIN_PASSWORD=YourSecurePassword123!
# SUPER_ADMIN_NAME=Platform Administrator

# =============================================================================
# Email Service Configuration (SMTP)
# =============================================================================
# Required for email verification, OTP, and workspace invitations

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@avenge-voice.com
# FROM_NAME=Avenge Voice
# FRONTEND_URL=http://localhost:3000
